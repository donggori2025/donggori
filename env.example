# =============================================================================
# 동고리(DONGGORI) 환경 변수 템플릿
# 복사: cp env.example .env.local
# =============================================================================

# 사이트 URL
# 로컬: http://localhost:3000
# 프로덕션: https://www.donggori.com
NEXT_PUBLIC_SITE_URL=https://www.donggori.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Vercel Blob (이미지)
BLOB_READ_WRITE_TOKEN=
IMAGE_SERVICE=vercel-blob

# 관리자
ADMIN_ID=
ADMIN_PW=
ADMIN_SESSION_SECRET=

# 공장(사장님) 세션
FACTORY_SESSION_SECRET=

# 내부 API
INTERNAL_API_SECRET=

# 네이버 OAuth
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 OAuth
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 지도
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# AWS S3 (선택)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=donggori-images
CLOUDFRONT_DOMAIN=

# 알림톡 (mock | 실제 제공자)
BIZMSG_PROVIDER=mock
BIZMSG_APP_KEY=
BIZMSG_SECRET=
BIZMSG_SENDER_KEY=
BIZMSG_SENDER_NUMBER=
NCP_BIZMSG_SERVICE_ID=

# SMS (mock | ncp_sens)
SMS_PROVIDER=mock
NCP_SENS_SERVICE_ID=
NCP_SENS_ACCESS_KEY=
NCP_SENS_SECRET_KEY=
NCP_SENS_SENDER=

# 이메일 OTP (mock | sendgrid)
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@donggori.com
SENDGRID_FROM_NAME=동고리
