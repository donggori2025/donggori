# =============================================================================
# 동고리(DONGGORI) 환경 변수 템플릿
# 복사: cp env.example .env.local
# =============================================================================

# 사이트 URL
# 로컬: http://localhost:3000
# 프로덕션: https://www.donggori.com
NEXT_PUBLIC_SITE_URL=https://www.donggori.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (이미지)
BLOB_READ_WRITE_TOKEN=

# 관리자
ADMIN_ID=
ADMIN_PW=
# 사용자 세션용 키와 관리자 세션용 키는 각각 별도 32바이트 이상 랜덤값을 사용
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# 네이버 OAuth
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 OAuth
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 지도
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 이메일 OTP (운영·로컬 모두 실제 SendGrid 설정 필요)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=동고리
