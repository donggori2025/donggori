# =============================================================================
# 동고리(DONGGORI) 환경 변수 템플릿
# 복사: cp docs/handover/.env.example .env.local
# =============================================================================

# 1. 사이트 URL (필수)
NEXT_PUBLIC_SITE_URL=https://www.donggori.com

# 2. Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Vercel Blob (필수)
BLOB_READ_WRITE_TOKEN=

# 4. 관리자 (필수)
ADMIN_ID=
ADMIN_PW=
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# 5. 네이버 OAuth (필수)
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 6. 카카오 OAuth (필수)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 7. 네이버 지도 (필수)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 8. 이메일 OTP (필수)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=동고리
