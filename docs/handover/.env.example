# =============================================================================
# 동고리(DONGGORI) 환경 변수 템플릿
# 복사: cp docs/handover/.env.example .env.local
# =============================================================================

# 1. 사이트 URL (필수)
NEXT_PUBLIC_SITE_URL=https://www.donggori.com

# 2. Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# 3. Vercel Blob (필수)
BLOB_READ_WRITE_TOKEN=
IMAGE_SERVICE=vercel-blob

# 4. 관리자 (필수)
ADMIN_ID=
ADMIN_PW=
ADMIN_SESSION_SECRET=

# 5. 공장 세션 (권장)
FACTORY_SESSION_SECRET=

# 6. 내부 API (선택)
INTERNAL_API_SECRET=

# 7. 네이버 OAuth (필수)
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 8. 카카오 OAuth (필수)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 9. 네이버 지도 (필수)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 10. AWS S3 (선택)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=donggori-images
CLOUDFRONT_DOMAIN=

# 11. 알림톡 (선택)
BIZMSG_PROVIDER=mock
BIZMSG_APP_KEY=
BIZMSG_SECRET=
BIZMSG_SENDER_KEY=
BIZMSG_SENDER_NUMBER=
NCP_BIZMSG_SERVICE_ID=

# 12. SMS (선택)
SMS_PROVIDER=mock
NCP_SENS_SERVICE_ID=
NCP_SENS_ACCESS_KEY=
NCP_SENS_SECRET_KEY=
NCP_SENS_SENDER=

# 13. 이메일 OTP (선택)
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@donggori.com
SENDGRID_FROM_NAME=동고리
